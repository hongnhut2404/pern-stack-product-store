# =========================
# DEPENDENCIES
# =========================
node_modules/
.pnp/
.pnp.js

# =========================
# ENVIRONMENT & SECRETS
# =========================
# Catch-all for environment files containing API keys, DB credentials, JWT secrets, etc.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# =========================
# BUILD OUTPUTS (Frontend & Backend)
# =========================
# Frontend build outputs (Vite / CRA / Next.js)
dist/
build/
.next/
.vite/

# Backend TypeScript compilation outputs
# (If your tsconfig outputs to a separate folder like dist/ or build/)
# (Covered by dist/ and build/ above, but keep in mind if using custom folders)

# =========================
# DATABASE & DOCKER (PERN Specific)
# =========================
# Local SQLite/database files (if used for testing/local mocks)
*.db
*.sqlite
*.sqlite3

# Local Docker volumes for PostgreSQL (if running Postgres via Docker Compose locally)
pgdata/
postgres_data/
.docker/

# =========================
# LOGS & RUNTIME DATA
# =========================
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# =========================
# TESTING & COVERAGE
# =========================
coverage/
.nyc_output/

# =========================
# OS & EDITOR FILES
# =========================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Editors & IDEs
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# =========================
# MISC CACHES
# =========================
.turbo/
.cache/
.parcel-cache/

# In backend/.gitignore or root .gitignore
backend/node_modules/
frontend/node_modules/

node_modules/
**/node_modules/
backend/node_modules/
frontend/node_modules/
